#!/usr/bin/env bash
# Portillon FORCÉ avant tout push — décision Romain du 2026-07-19, volet 2
# (hub/decisions/2026-07-19-confronter-via-oracle-et-restaurer-tous-les-guards.md).
#
# Ce fichier est VERSIONNÉ dans scripts/githooks/ et installé par `./scripts/install-hooks.sh`.
# Il n'est jamais posé à la main dans .git/hooks : un garde qui vit hors du dépôt disparaît
# au premier clone, et c'est exactement comme ça qu'un portillon se vide sans que personne
# le voie.
#
# Voie RAPIDE seulement. Les voies « rouge » (défauts moteur connus, BPE-21) et « lente »
# (test-all, BPE-22) ne bloquent pas le push : les lancer à la main, ou depuis l'intégration
# continue quand elle existera.
#
# Contournement : `git push --no-verify`. Il est volontairement possible — mais il devient
# alors un acte explicite et traçable, au lieu du silence d'avant.

# ⛔ LE COURRIER NON LU REFUSE LA POUSSÉE, ET SEULEMENT ICI. Un dépôt a poussé dans la fenêtre d'un
# voisin après avoir lu QUATRE messages sur SIX : le lot d'affichage est borné à quatre, et la
# ligne « N à suivre » ne suffit pas. ⇒ « 0 non-lu » est le seul verdict, jamais l'écran.
# ⚠️ SA PLACE EST LE GESTE DE POUSSÉE, jamais un site de bascule : le portillon dure des minutes et
# le courrier arrive toutes les une à deux minutes — branché ailleurs, il mesure un autre instant
# que le geste et refuse deux poussées de suite.
# ⇒ Ce refus vivait dans le garde de fenêtre, qui en portait DEUX. Retirer le mécanisme de gel a
#   emporté celui-ci avec lui : mesuré ici le 2026-09-05, crochet à 21 verts et code 0 avec deux
#   lettres non lues en boîte. Deux refus dans un même fichier sont DEUX gardes.
bash "$HOME/dev/bp/hub/tools/garde-courrier-non-lu.sh" || exit 1

# ⛔ LES GARDES PARTAGÉS PASSENT PAR LE POINT D'ENTRÉE DU HUB, ET LEUR LISTE N'EST PAS ÉCRITE ICI.
# Ce crochet portait la liste en dur — deux noms — et c'est le défaut mesuré par l'architecte le
# 2026-09-04 : quinze copies de la liste, un garde neuf n'atteignant personne, et rien qui le dise.
# `gardes-du-portillon.sh` est appelé avec mon nom ; il porte aujourd'hui la navigation, les copies
# diffusées, le retard de publication, les sources voisines et la traversée, et ce qu'il portera
# demain arrive sans geste ici.
#
# ⇒ EN TÊTE, ET NON DANS `gate.sh` : ils décident si la poussée a le droit d'avoir lieu, et ils
#   refusent avant que le portillon ne dépense ses quarante secondes. Le retard de publication, en
#   particulier, ne PEUT PAS vivre dans le portillon : le maillon qui prouve son branchement relance
#   ce crochet, donc le portillon — s'y placer le rendrait récursif.
BP_AGENT=bp3-engine bash "$HOME/dev/bp/hub/tools/gardes-du-portillon.sh" bp3-engine || exit $?

racine="$(git rev-parse --show-toplevel)"
echo "── portillon bp3-engine (voie rapide) ───────"
if "$racine/scripts/gate.sh" rapide; then
  exit 0
fi
echo
echo "PUSH REFUSÉ : le portillon est rouge. Corrigez, ou expliquez-vous avec --no-verify."
exit 1
